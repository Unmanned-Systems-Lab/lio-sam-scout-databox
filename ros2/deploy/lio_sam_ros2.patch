+            {
+                RCLCPP_WARN(get_logger(), "Ignoring cloud with invalid relative point time");
+                return false;
+            }
+            scanDuration = std::max(scanDuration, static_cast<double>(point.time));
+        }
+        timeScanEnd = timeScanCur + scanDuration;
+
