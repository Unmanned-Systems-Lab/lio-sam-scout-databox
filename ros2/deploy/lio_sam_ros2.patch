-        timeScanEnd = timeScanCur + laserCloudIn->points.back().time;
     
         // remove Nan
         vector<int> indices;
         pcl::removeNaNFromPointCloud(*laserCloudIn, *laserCloudIn, indices);
 
+        if (laserCloudIn->empty())
+        {
+            RCLCPP_WARN(get_logger(), "Ignoring empty point cloud after NaN removal");
+            return false;
+        }
+        // RoboSense clouds may be organized by ring rather than capture time.
+        // Require IMU coverage through the latest point, not only the last one.
+        double scanDuration = 0.0;
+        for (const auto &point : laserCloudIn->points)
+        {
+            if (!std::isfinite(point.time) || point.time < 0.0f || point.time > 0.2f)
+            {
+                RCLCPP_WARN(get_logger(), "Ignoring cloud with invalid relative point time");
+                return false;
+            }
+            scanDuration = std::max(scanDuration, static_cast<double>(point.time));
+        }
+        timeScanEnd = timeScanCur + scanDuration;
+
         // check dense flag
         if (laserCloudIn->is_dense == false)
         {
